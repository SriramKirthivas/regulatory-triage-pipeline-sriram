# Copy to .env — the Docker path already has sane defaults baked into docker-compose.yml,
# so you only need this file if you run the API directly on your host.

# Postgres is published on 5433 to avoid clashing with a local Postgres on 5432.
DATABASE_URL=postgresql+psycopg://rtp:rtp@localhost:5433/rtp

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seed the database automatically when the API boots (idempotent).
SEED_ON_STARTUP=true

# Frontend -> API base URL (used by web/, read at build time by Vite).
VITE_API_URL=http://localhost:8000
